{
  "name": "@enigma-ui/css",
  "version": "0.0.0",
  "description": "The Enigma Technology Lab design system in plain CSS: brand fonts, light and dark tokens measured to 7:1, and the component styles. Works in any stack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enigma-tech-labs/enigma-ui.git",
    "directory": "packages/css"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "css",
    "accessibility",
    "rtl",
    "arabic"
  ],
  "files": [
    "ui.css",
    "tailwind.css",
    "fonts",
    "README.md"
  ],
  "style": "./ui.css",
  "exports": {
    "./ui.css": "./ui.css",
    "./tailwind.css": "./tailwind.css",
    "./fonts/*": "./fonts/*"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@enigma-ui/react",
  "version": "0.0.0",
  "description": "Accessible React components in the Enigma Technology Lab design system, right to left ready: alert dialog, badge, button, card, data table, dialog, pagination, select, text field and textarea. Built on React Aria.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enigma-tech-labs/enigma-ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "accessibility",
    "rtl",
    "react-aria"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "@enigma-ui/css": "^0.0.0",
    "@internationalized/date": "^3.12.4",
    "react-aria-components": "^1.22.1",
    "@enigma-ui/icons": "^0.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
